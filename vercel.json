{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin-control-hq.html",
      "destination": "/admin-control-hq.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-control-hq.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
